{
  // Managed by chezmoi (macOS). Keep this file minimal: only settings that make
  // the toolchain deterministic belong here. Formatting and editor conventions
  // are deliberately left to each project.

  // Homebrew OpenJDK 25 is the default development JDK; OpenJDK 21 stays
  // available for projects that still require it. The versioned "opt" paths are
  // stable across patch releases; the Cellar path is never referenced. This is
  // also what a Finder/Dock-launched VS Code uses, since a GUI launch does not
  // inherit the Zsh PATH or JAVA_HOME.
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-25",
      "path": "/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home",
      "default": true
    },
    {
      "name": "JavaSE-21",
      "path": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
    }
  ],

  // Homebrew CPython, discovered even when VS Code is launched from Finder.
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",

  // Appearance captured from this machine's manual setup: the Catppuccin Mocha
  // colour theme (catppuccin.catppuccin-vsc) and the Material file/folder icon
  // theme (PKief.material-icon-theme), both installed from
  // manifests/vscode-extensions.txt. Editor font and formatting stay per-user / per-project.
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "Catppuccin Mocha",

  // Show each nested single-child folder on its own line in the Explorer
  // instead of collapsing them into one "parent/child" row.
  "explorer.compactFolders": false,

  // No Red Hat Java telemetry, set explicitly so
  // the extension does not re-prompt after a chezmoi apply.
  "redhat.telemetry.enabled": false,

  // Copilot is not part of this setup; keep it off everywhere it could
  // otherwise auto-suggest, including commit messages and the SCM input.
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },

  // Drop the macOS title bar's command center (search/nav dropdown); the
  // Command Palette (Cmd+Shift+P) covers the same ground.
  "window.commandCenter": false
}
