# No identity is versioned here. Git reads it from untracked files (see the
# includes at the end); without one it refuses to commit instead of guessing a
# name and email from the machine.
[user]
	useConfigOnly = true

[init]
	defaultBranch = main
[fetch]
	prune = true
	pruneTags = true
[pull]
	ff = only
	rebase = false
[push]
	default = current
	autoSetupRemote = true
[core]
	excludesFile = ~/.config/git/ignore
# Git LFS (brew/dev.Brewfile), as `git lfs install` would write it. Kept here
# because that command edits ~/.gitconfig, which chezmoi manages. Repositories
# without LFS attributes are unaffected.
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[color]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = zebra
	mnemonicPrefix = true
[merge]
	conflictStyle = zdiff3
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[alias]
	st = status --short --branch
	sw = switch
	co = checkout
	br = branch
	ci = commit
	last = log -1 --stat
	lg = log --graph --decorate --date=short --pretty=format:"%C(auto)%h %C(blue)%ad%Creset %C(auto)%d%Creset %s - %an" --all
	unstage = restore --staged --

# Commit identity, from untracked files; later includes win and Git skips an
# include whose file is absent. SSH authentication is separate (host aliases
# in ~/.ssh/config).
# 1. Default identity for every repository.
[include]
	path = ~/.config/git/identity.gitconfig
# 2. Per-account identity by repository location ([user] name and email only).
[includeIf "gitdir:~/Developer/personal/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/Developer/college/"]
	path = ~/.gitconfig-college

# 3. Per-machine overrides (signing keys, credential helpers, work paths).
# Loaded last so it wins everywhere; never committed.
[include]
	path = ~/.config/git/local.gitconfig
