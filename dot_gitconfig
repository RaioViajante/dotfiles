[user]
	name = raioviajante
	email = 195070286+RaioViajante@users.noreply.github.com

[init]
	defaultBranch = main
[fetch]
	prune = true
	pruneTags = true
[pull]
	ff = only
	rebase = false
[push]
	default = current
	autoSetupRemote = true
[core]
	excludesFile = ~/.config/git/ignore
[color]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = zebra
	mnemonicPrefix = true
[merge]
	conflictStyle = zdiff3
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[alias]
	st = status --short --branch
	sw = switch
	co = checkout
	br = branch
	ci = commit
	last = log -1 --stat
	lg = log --graph --decorate --date=short --pretty=format:"%C(auto)%h %C(blue)%ad%Creset %C(auto)%d%Creset %s - %an" --all
	unstage = restore --staged --

# Optional per-machine overrides (identity, signing keys, work paths).
# Loaded last so it wins; the file is never committed. Safe to leave absent.
[include]
	path = ~/.config/git/local.gitconfig
