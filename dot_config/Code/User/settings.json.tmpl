{
  // Managed by chezmoi (Linux only). macOS keeps its own VS Code settings.
  // Formatting behaviour is deliberately left to each project.

  "terminal.integrated.defaultProfile.linux": "zsh",
  "editor.formatOnSave": false,
  "files.autoSave": "off",
  "editor.codeActionsOnSave": {},
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "update.mode": "none",
  "extensions.autoCheckUpdates": false,

  // Show each nested single-child folder on its own line in the Explorer
  // instead of collapsing them into one "parent/child" row.
  "explorer.compactFolders": false,

  // Eclipse Temurin runtimes from SDKMAN. Keep versions in sync with
  // scripts/fedora/40-java.sh and .chezmoi.toml.tmpl.
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-25",
      "path": "{{ .chezmoi.homeDir }}/.sdkman/candidates/java/{{ .java.default }}",
      "default": true
    },
    {
      "name": "JavaSE-21",
      "path": "{{ .chezmoi.homeDir }}/.sdkman/candidates/java/{{ .java.lts }}"
    }
  ]
}
