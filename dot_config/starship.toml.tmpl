add_newline = false
command_timeout = 800
# Windows directory scans are slower (Defender); 20 ms produces timeout warnings there.
scan_timeout = {{ if eq .chezmoi.os "windows" }}100{{ else }}20{{ end }}

[directory]
truncation_length = 4
truncate_to_repo = true

[git_branch]
symbol = "git:"

[git_status]
format = "([$all_status$ahead_behind]($style) )"

[nodejs]
symbol = "node:"

[java]
symbol = "java:"

[docker_context]
symbol = "docker:"
