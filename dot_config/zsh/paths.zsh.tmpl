typeset -U path PATH

# User-local executables (all platforms).
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)

{{ if eq .chezmoi.os "darwin" -}}
# Visual Studio Code CLI shipped inside the macOS application bundle.
[[ -d "/Applications/Visual Studio Code.app/Contents/Resources/app/bin" ]] && \
  path=("/Applications/Visual Studio Code.app/Contents/Resources/app/bin" $path)

# Java 21 LTS is the default for Java and Spring Boot work.
typeset -g JAVA_21_HOME="/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
if [[ -d "$JAVA_21_HOME" ]]; then
  export JAVA_HOME="$JAVA_21_HOME"
  path=("$JAVA_HOME/bin" $path)
fi

# pnpm is installed by Homebrew, so PNPM_HOME is intentionally not added.
{{ else if eq .chezmoi.os "linux" -}}
# fnm (Node version manager) is installed under the user data directory.
[[ -d "$HOME/.local/share/fnm" ]] && path=("$HOME/.local/share/fnm" $path)

# pnpm global binaries (Corepack-managed pnpm). Both layouts are covered:
# pnpm places binaries in $PNPM_HOME, older setups use $PNPM_HOME/bin.
export PNPM_HOME="$HOME/.local/share/pnpm"
[[ -d "$PNPM_HOME" ]] && path=("$PNPM_HOME" $path)
[[ -d "$PNPM_HOME/bin" ]] && path=("$PNPM_HOME/bin" $path)

# JDKs are managed by SDKMAN, which prepends its own shims in integrations.zsh.
{{ end -}}
export PATH
