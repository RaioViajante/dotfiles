#!/bin/bash
# Dotfiles revision: {{ include "dot_gitconfig" | sha256sum }}
set -euo pipefail

# Portable post-apply setup: local directories and the optional Git override file.
git_local="$HOME/.config/git/local.gitconfig"
mkdir -p "$(dirname "$git_local")" "$HOME/.cache/zsh" "$HOME/.local/bin"

# The shared Git identity ships in dot_gitconfig and works immediately.
# ~/.config/git/local.gitconfig is optional and only for per-machine overrides
# (a different identity, signing keys, work paths). Create it empty so it can be
# edited in place; it is never committed.
if [[ ! -e "$git_local" ]]; then
  install -m 600 /dev/null "$git_local"
else
  chmod 600 "$git_local"
fi

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew, git and clang need the Command Line Tools, not full Xcode.app.
if ! xcode-select -p >/dev/null 2>&1; then
  cat >&2 <<'MESSAGE'
Xcode Command Line Tools are required (clang, git and other build tools used
by Homebrew and this setup) and were not found. Install them with:

    xcode-select --install

This opens Apple's standard installer; follow the prompts, then re-run
`chezmoi apply`. Full Xcode.app is only needed for iOS/macOS app development,
not for this setup, and is not managed here since Apple does not ship a
Homebrew cask for it -- but installing it from the Mac App Store also
satisfies this check, since it includes the Command Line Tools:

    open 'macappstore://apps.apple.com/app/id497799835'
MESSAGE
fi
{{ end -}}
