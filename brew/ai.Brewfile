# AI tools. The Claude Code, Codex and Kimi Code CLIs come from their vendors'
# installers (scripts/macos/install-ai-clis.sh). Claude Desktop includes Claude
# Code; the ChatGPT desktop app is OpenAI's official app for Codex (the
# standalone codex-app cask is deprecated). The Kimi desktop app is a manual
# install from kimi.com. Sign-in stays manual.
cask "claude"
cask "chatgpt"

# Terminal AI coding agent, installed and updated by Homebrew.
brew "opencode"
