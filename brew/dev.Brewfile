# Development tools: language runtimes, databases, CLIs and developer apps.
# Editors come with their configuration modules (vscode, nvim). Requires
# brew/shared/node.Brewfile.

# GitHub, diagnostics and repository checks (ShellCheck and gitleaks also run
# in CI).
brew "gh"
brew "htop"
brew "nmap"
brew "shellcheck"
brew "gitleaks"

# JavaScript / TypeScript
brew "pnpm"
brew "angular-cli"
brew "vercel"

# Java / Spring Boot. Java 25 is the shell default; `jdk 21` switches.
brew "openjdk@21"
brew "openjdk@25"
brew "maven"

# Database
brew "mysql"

# PHP
brew "php"
brew "composer"

# Python. Homebrew Python is the default interpreter; uv manages per-project
# environments and Python versions (.python-version / pyproject.toml).
brew "python@3.14"
brew "uv"

# Mac App Store CLI for scripts/macos/install-mas-apps.sh (Xcode). The App Store
# sign-in stays a manual step.
brew "mas"

cask "docker-desktop"
cask "intellij-idea"
cask "postman"
cask "mysqlworkbench"
# Frontend work and DevTools.
cask "firefox@developer-edition"
