# Shell and terminal module: prompt, navigation and listing tools used by
# dot_config/zsh, the iTerm2 terminal and the Nerd Font its profile uses.
# Requires brew/shared/ripgrep.Brewfile and brew/shared/chezmoi.Brewfile.
brew "starship"
brew "zoxide"
brew "fzf"
brew "eza"
brew "bat"
cask "iterm2"
cask "font-jetbrains-mono-nerd-font"
