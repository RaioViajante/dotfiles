# Desktop apps: productivity, communication, browsers and the Proton suite.
# Sign-in stays manual. TeamSpeak 6 (beta) and Proton Authenticator are manual
# installs: no usable Homebrew package exists for them.

cask "alt-tab"
cask "notion"
cask "obsidian"
cask "google-drive"
# Whiteboard / diagram notes. Native macOS Excalidraw client (third-party).
cask "excalidrawz"

cask "discord"
cask "whatsapp"
cask "spotify"

# Browsers. Zen is the daily driver; Tor Browser stays independent. Firefox
# Developer Edition belongs to the dev module. No Chrome.
cask "zen"
cask "tor-browser"

# Proton ecosystem and VPN. Account sign-in and the macOS network-extension
# approval stay manual. Proton Mail covers both Mail and Calendar.
cask "proton-mail"
cask "proton-pass"
cask "proton-drive"
cask "protonvpn"
# Background IMAP/SMTP bridge for local mail clients and integrations; left out
# of the Dock by scripts/macos/apply-preferences.sh.
cask "proton-mail-bridge"

# Dock management for scripts/macos/apply-preferences.sh.
brew "dockutil"
